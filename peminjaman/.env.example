# Salin menjadi .env. JWT_SECRET harus SAMA dengan yang ada di katalog/.env. JANGAN commit .env.
PORT=3002
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=1h
DB_FILE=./data/peminjaman.db
# Alamat API Katalog (dipanggil lewat HTTP, bukan baca database-nya)
KATALOG_URL=http://localhost:3001/api/v1
KATALOG_TIMEOUT_MS=3000
